# .gitignore for DevOps Challenge
# Ignore PowerShell script output, logs, and temp files
*.log
*.tmp
*.bak
*.swp
*.swo
*.ps1~
*.ps1.save

# Ignore logs directory and its contents
logs/

# Ignore system files
.DS_Store
Thumbs.db
Desktop.ini

# Ignore VS Code settings
.vscode/

# Ignore Python cache if any scripts are added
__pycache__/
*.pyc

# Ignore node_modules if any JS tooling is used
node_modules/

# Ignore environment files
.env
.env.*

# Ignore package lock files
package-lock.json
yarn.lock

# Ignore compiled binaries
*.exe
*.dll
*.out
*.class

# Ignore archives
*.zip
*.tar.gz
*.tar
*.rar
*.7z

# Ignore coverage and test output
coverage/
*.coverage

# Ignore personal settings
*.sublime-workspace
*.sublime-project
.idea/
*.iml
